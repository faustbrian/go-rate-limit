      "purpose": "Transport-neutral inbound rate limiting for Go applications. The package provides deterministic token-bucket, fixed-window, bounded sliding-counter, and concurrency-lease policies with memory, native Valkey, and native PostgreSQL backends.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "resilience",
      "family_label": "Resilience",
      "family_description": "Explicit admission, isolation, retry, amplification, and failure policies.",
      "family_order": 5,
      "cohesion": {
        "family": "resilience",
        "secondary_capabilities": [
          "database-and-storage",
          "http-and-service-edge",
          "observability"
        ],
        "responsibility": "Provide transport-neutral inbound admission policies, bounded memory and distributed backends, concurrency leases, and explicit HTTP, RPC, queue, principal, logging, and telemetry integrations.",
        "non_goals": [
          "Own authorization, billing quotas, WAF rules, queue acknowledgement, outbound retries, or HTTP transport pacing."
        ],
        "public_package_identifier": "ratelimit",
        "primary_entry_packages": [
          "github.com/faustbrian/go-rate-limit"
        ],
        "package_selection": {
          "github.com/faustbrian/go-rate-limit": "Use for immutable admission policies, typed decisions and errors, service orchestration, batches, and concurrency-lease contracts.",
          "github.com/faustbrian/go-rate-limit/memory": "Use for bounded process-local admission state when limits do not need cross-replica authority.",
          "github.com/faustbrian/go-rate-limit/postgres": "Use for transactional PostgreSQL-backed admission, concurrency leases, cleanup, and migration ownership.",
          "github.com/faustbrian/go-rate-limit/ratelimithttp": "Use for net/http inbound admission middleware and trusted-proxy client identity extraction.",
          "github.com/faustbrian/go-rate-limit/ratelimitlog": "Use to adapt bounded admission observations to caller-owned slog logging.",
          "github.com/faustbrian/go-rate-limit/ratelimitprincipal": "Use to derive bounded hashed rate-limit subjects from authentication principals.",
          "github.com/faustbrian/go-rate-limit/ratelimitqueue": "Use for queue admission middleware without changing acknowledgement or retry ownership.",
          "github.com/faustbrian/go-rate-limit/ratelimitrpc": "Use for transport-neutral JSON-RPC admission middleware.",
          "github.com/faustbrian/go-rate-limit/ratelimittelemetry": "Use to adapt bounded admission observations to caller-owned OpenTelemetry meters.",
          "github.com/faustbrian/go-rate-limit/ratelimittest": "Use in tests for deterministic clocks, reference models, and backend conformance.",
          "github.com/faustbrian/go-rate-limit/valkey": "Use for atomic distributed admission and concurrency leases backed by Valkey."
        },
